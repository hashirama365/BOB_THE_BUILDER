# Bob Inference API key — obtain an Inference-scoped key from the Bob portal.
# No team ID header is required; the key alone authenticates the request.
BOB_API_KEY=YOUR_KEY_HERE

# Full URL of the Bob chat-completions endpoint. No changes should be needed here
# unless IBM moves the endpoint or you are targeting a different region.
BOB_INFERENCE_URL=https://api.us-east.bob.ibm.com/v1/chat/completions

# Model identifier passed in every request body. "auto" lets Bob's LiteLLM router
# pick the best available model automatically. Replace with a specific model name
# (e.g. ibm-granite-3-8b-instruct) if you need a pinned version.
BOB_MODEL=auto
